# Public (safe for the browser)
NEXT_PUBLIC_APP_NAME=SYLQEN
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# MongoDB (required for auth/workspaces)
# Local: mongodb://127.0.0.1:27017/sylqen
# Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sylqen?retryWrites=true&w=majority
# Rules for Vercel/env dashboards:
# - Paste the raw URI only (no surrounding quotes / smart quotes)
# - No leading/trailing whitespace
# - Keep the Atlas DB password unchanged; if it contains reserved characters
#   (: / ? # [ ] @), percent-encode ONLY those characters inside this URI
#   (examples: @ → %40, : → %3A, / → %2F, ? → %3F, # → %23, [ → %5B, ] → %5D)
# - Replace Atlas <password> placeholders with the real password (encoded as needed)
# - Production DB name is typically sylqen (also set MONGODB_DB_NAME)
MONGODB_URI=mongodb://127.0.0.1:27017/sylqen
MONGODB_DB_NAME=sylqen
# Opt-in Mongo transactions (Atlas replica set). Leave unset/false on Vercel
# unless you explicitly need multi-document transactions.
MONGODB_USE_TRANSACTIONS=false

# Better Auth (required in deployed environments)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — enables Continue with Google)
# Server-only: never prefix with NEXT_PUBLIC_
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URIs (exact):
#   Local:      http://localhost:3000/api/auth/callback/google
#   Production: https://sylqen.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (optional for current portfolio/demo stage)
# Signup/sign-in do NOT require outbound email right now.
# Keep Resend ready for future verification / password-reset activation:
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=...
#   EMAIL_FROM=SYLQEN <your-verified-sender@domain>
# Local/dev default captures messages in memory (refused if used for real
# outbound sends on Vercel production).
EMAIL_PROVIDER=dev
RESEND_API_KEY=
EMAIL_FROM=SYLQEN <onboarding@resend.dev>
# Optional local disk capture for manual debugging (never commit .local/)
EMAIL_CAPTURE_TO_DISK=false

# Portfolio demo account (optional locally; required for Explore Demo in Production)
# Vercel Production MUST set DEMO_EMAIL and DEMO_PASSWORD (DEMO_NAME optional)
DEMO_EMAIL=demo@sylqen.app
DEMO_PASSWORD=replace-with-a-strong-demo-password
DEMO_NAME=SYLQEN Demo

# AI — disabled by default
AI_ENABLED=false
AI_PROVIDER=mock

# Reserved for later phases
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# STORAGE_BUCKET=
